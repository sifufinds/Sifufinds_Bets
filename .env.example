# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
# Service role key — NEVER commit to public repos. Server-side use only.
SUPABASE_SERVICE_KEY=your_service_role_key_here
SUPABASE_DB_PASSWORD=your_database_password
SUPABASE_DB_URL=postgresql://postgres.your-ref:your_db_password@aws-0-your-region.pooler.supabase.com:5432/postgres
SUPABASE_DB_PASSWORD=your_database_password_here
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your_db_password@aws-0-your-region.pooler.supabase.com:5432/postgres

# ── Email (Hostinger SMTP) ────────────────────────────────────────────────────
# Used by server-side agents and edge functions to send email
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=your_email@yourdomain.com
SMTP_PASS=your_email_password_here
SMTP_FROM_NAME=YourSite Team

# ── EmailJS ───────────────────────────────────────────────────────────────────
# https://www.emailjs.com — free tier: 200 emails/month
# Public key is safe to use client-side; private key is server-side only
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id

# ── Formsubmit.co (contact form email forwarder) ──────────────────────────────
# https://formsubmit.co — free, no-backend email forwarding
# Activate by submitting the form once (sends confirmation to recipient email)
FORMSUBMIT_ENDPOINT=https://formsubmit.co/ajax/your_email@yourdomain.com

# ── AI ────────────────────────────────────────────────────────────────────────
GROQ_API_KEY=

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# ── Facebook / Instagram ──────────────────────────────────────────────────────
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ── Sanity CMS (blog authoring — syncs into blog/posts.json, does not replace the generator) ──
# Get project ID/dataset from https://www.sanity.io/manage — API token from Project → API → Tokens (Viewer scope is enough for the read-only sync script)
SANITY_PROJECT_ID=your_sanity_project_id
SANITY_DATASET=production
SANITY_API_TOKEN=your_sanity_api_token

# ── Sports Data APIs ──────────────────────────────────────────────────────────
# SportAPI7 (sportapi7.p.rapidapi.com) — powers Tables page (sifufinds.com/tables/)
# SofaScore-based: 1 call gets ALL today's matches with live scores.
# Sign up at https://rapidapi.com/fluis.lacasse/api/sportapi7
# Add as GitHub Actions secret: FOOTBALL_API_KEY
# Then run manually: python3 update_football_data.py
FOOTBALL_API_KEY=
ODDS_API_KEY=
